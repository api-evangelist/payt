{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Endpoints administrations contacts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get administration contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paytsoftware.com/v1/contacts",
            "params": [
              {
                "name": "administration_id",
                "value": "",
                "type": "query",
                "description": "Administration identifier"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Filter contacts with a comma separated list of internal ids"
              },
              {
                "name": "contact_identifiers",
                "value": "",
                "type": "query",
                "description": "Filter contacts with a comma separated list of contact identifiers from your accounting software"
              },
              {
                "name": "debtor_numbers",
                "value": "",
                "type": "query",
                "description": "Filter contacts with a comma separated list of debtor numbers"
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query",
                "description": "ISO8601 UTC Timestamp to filter records updated after it"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "JSON object defining fields to receive (e.g {\"only\": [\"field1\", {\"field2\": [\"field3\"]}]})"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The record identifier after which to start the page"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "How many records will be returned per page, (1..500), defaults to 100"
              }
            ]
          },
          "docs": "Get administration contacts"
        },
        {
          "info": {
            "name": "Create or update administration contacts",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paytsoftware.com/v1/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update administration contacts"
        }
      ]
    }
  ],
  "bundled": true
}