            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.paytsoftware.com/v1/payment_plans/:id/approve",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Payment plan identifier"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "administration_id",
                  "value": ""
                },
                {
                  "name": "fields",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Approve a proposed payment plan"
        },
        {
          "info": {
            "name": "Deactivate an active payment plan",
