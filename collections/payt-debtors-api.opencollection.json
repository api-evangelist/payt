{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Endpoints administrations debtors API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "debtors",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get administration debtors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paytsoftware.com/v1/debtors",
            "params": [
              {
                "name": "administration_id",
                "value": "",
                "type": "query",
                "description": "Administration identifier"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Filter debtors with a comma separated list of internal ids"
              },
              {
                "name": "debtor_numbers",
                "value": "",
                "type": "query",
                "description": "Filter debtors with a comma separated list of debtor numbers"
              },
              {
                "name": "debtor_identifiers",
                "value": "",
                "type": "query",
                "description": "Filter debtors with a comma separated list of debtor identifiers from your accounting software"
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query",
                "description": "ISO8601 UTC Timestamp to filter records updated after it"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "JSON object defining fields to receive (e.g {\"only\": [\"field1\", {\"field2\": [\"field3\"]}]})"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "The record identifier after which to start the page"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "How many records will be returned per page, (1..500), defaults to 100"
              }
            ]
          },
          "docs": "Get administration debtors"
        },
        {
          "info": {
            "name": "Create or update administration debtors",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paytsoftware.com/v1/debtors",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update administration debtors"
        },
        {
          "info": {
            "name": "Get administration debtor by id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paytsoftware.com/v1/debtors/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Debtor identifier"
              },
              {
                "name": "administration_id",
                "value": "",
                "type": "query",
                "description": "Administration identifier"
              },
              {
                "name": "identifier_type",
                "value": "",
                "type": "query",
                "description": "Type of debtor identifier to use (can be 'debtor_number', 'debtor_identifier' or left blank to use internal id)"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "JSON object defining fields to receive (e.g {\"only\": [\"field1\", {\"field2\": [\"field3\"]}]})"
              }
            ]
          },
          "docs": "Get administration debtor by id"
        }
      ]
    }
  ],
  "bundled": true
}